{
  "name": "dashboard-jira-server",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build:exe": "pkg . --output ../release/DashboardJira.exe && node scripts/set-windows-gui.js ../release/DashboardJira.exe && node -e \"require('fs').copyFileSync('.env.example', '../release/.env.example')\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.13.1",
    "nodemon": "^3.1.9"
  },
  "bin": "src/index.js",
  "pkg": {
    "assets": [
      "../client/dist/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ]
  }
}
